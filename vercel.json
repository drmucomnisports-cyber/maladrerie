{
  "version": 2,
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "backend/assets/**"
    },
    "api/stripe/webhook.js": {
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/api/stripe/webhook",
      "dest": "api/stripe/webhook.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "api/index.js"
    },
    {
      "src": "/photos/(.*)",
      "dest": "/photos/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/logo-muc.(png|jpg)",
      "dest": "/logo-muc.$1"
    },
    {
      "src": "/favicon.svg",
      "dest": "/favicon.svg"
    },
    {
      "src": "/robots.txt",
      "dest": "/robots.txt"
    },
    {
      "src": "/sitemap.xml",
      "dest": "/sitemap.xml"
    },
    {
      "src": "/googledcc0ca1db9abbc14.html",
      "dest": "/googledcc0ca1db9abbc14.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/devis",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/reminders",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/lieux-emails",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/cron/tax-report",
      "schedule": "0 9 1 * *"
    },
    {
      "path": "/api/cron/cuisine",
      "schedule": "0 9 * * 4"
    }
  ]
}

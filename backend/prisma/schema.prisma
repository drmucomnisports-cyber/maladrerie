datasource db {
  provider = "postgresql"
  url      = env("NEON_DB_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Client {
  id             Int           @id @default(autoincrement())
  nom            String
  email          String
  telephone      String
  adressePostale String?
  reservations   Reservation[]
  createdAt      DateTime      @default(now())
}

model Reservation {
  id              Int          @id @default(autoincrement())
  client          Client       @relation(fields: [clientId], references: [id])
  clientId        Int
  chambres        Int[]        // Gardé pour la compatibilité avec le calendrier
  chambresDetails Json?        // Array of objects { id, adultes, enfants, prix }
  options         Json?        // Objets { litsFaits, lingeFourni, menage }
  repas           Json?
  salles          Json?
  prixTotal       Float?
  montantAcompte  Float?
  montantSolde    Float?
  statutPaiement  String       @default("EN_ATTENTE") // EN_ATTENTE, ACOMPTE_PAYE, PAYE
  modePaiement    String?      // STRIPE, ESPECES, CHEQUE, VIREMENT
  statutCaution   String       @default("NON_DEMANDEE") // NON_DEMANDEE, EN_ATTENTE, DEPOSEE, UTILISEE, RESTITUEE
  stripeSessionId String?      // Legacy or generic
  stripeAcompteId String?
  stripeSoldeId   String?
  stripeCautionId String?
  dateDebut       DateTime
  dateFin         DateTime
  statut          String       @default("EN_ATTENTE") // EN_ATTENTE, ACCEPTEE, REFUSEE, RESERVE, DEVIS_EN_ATTENTE, DEVIS_EXPIRE
  validePar       String?      // Nom de l'admin ayant validé
  tokenDevis      String?      @unique
  tokenPolice     String?      @unique
  devisSignature  String?
  tokenModification String?    @unique
  modificationProposed Json?
  expireLe        DateTime?    // Pour les devis (48h)
  numeroDevis     String?      @unique
  numeroFacture   String?      @unique
  isGroupe        Boolean      @default(false)
  lienPaiementEnvoye Boolean   @default(false)
  cuisineEmailEnvoye Boolean   @default(false)
  montantCautionRetenu Float?  // Montant effectivement retenu sur la caution (ex: 50€ pour ménage)
  codePromo       String?      // Code promo utilisé
  structure       String?      // Nom de l'entreprise ou association
  intervenant     Intervenant? @relation(fields: [intervenantId], references: [id])
  intervenantId   Int?
  missions        Mission[]
  occupants       Occupant[]
  valideLe        DateTime?
  payeLe          DateTime?
  souhaitePayerSoldeArrivee Boolean @default(false)
  fichesPolice    Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Occupant {
  id            Int         @id @default(autoincrement())
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  reservationId Int
  nom           String
  prenom        String
  estAdulte     Boolean     @default(true)
  age           Int?
  nationalite   String?
}

model Intervenant {
  id             Int             @id @default(autoincrement())
  nom            String
  prenom         String
  telephone      String
  email          String          @unique
  password       String?
  statut         String          @default("SALARIE") // "SALARIE" ou "INDEPENDANT"
  recevoirRappels Boolean         @default(true)
  disponibilites Disponibilite[]
  reservations   Reservation[]
  missions       Mission[]
}

model Mission {
  id                Int         @id @default(autoincrement())
  intervenant       Intervenant @relation(fields: [intervenantId], references: [id], onDelete: Cascade)
  intervenantId     Int
  reservation       Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  reservationId     Int
  typeMission       String
  montant           Float
  date              DateTime?
  statut            String      @default("EN_ATTENTE") // EN_ATTENTE, ACCEPTEE, REFUSEE
  rappelsDesactives Boolean     @default(false)
}

model Disponibilite {
  id            Int         @id @default(autoincrement())
  intervenant   Intervenant @relation(fields: [intervenantId], references: [id], onDelete: Cascade)
  intervenantId Int
  dateDebut     DateTime
  dateFin       DateTime
}

model PromoCode {
  id            Int       @id @default(autoincrement())
  code          String    @unique
  description   String?
  type          String    @default("pourcentage") // "pourcentage" ou "fixe"
  valeur        Float     // ex: 10 pour 10% ou 10€
  actif         Boolean   @default(true)
  dateExpiration DateTime?
  usageMax      Int?      // nombre max d'utilisations (null = illimité)
  usageActuel   Int       @default(0)
  createdAt     DateTime  @default(now())
}
model AdminAccount {
  id                      Int      @id @default(autoincrement())
  email                   String   @unique
  password                String
  nom                     String?
  telephone               String?
  createdAt               DateTime @default(now())

  // Préférences de notification
  notifNewReservation     Boolean  @default(true)
  notifNewDevis           Boolean  @default(true)
  notifDevisValidation    Boolean  @default(true)
  notifPaymentReceived    Boolean  @default(true)
  notifModificationRequest Boolean  @default(true)
  notifIntervenantMissions Boolean  @default(true)
}

model Expense {
  id          Int      @id @default(autoincrement())
  date        DateTime @default(now())
  label       String
  montant     Float
  categorie   String
  comptePcg   String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

